# ==============================================================================
# LOOPS WORK — PRODUCTION HARDENED .GITIGNORE
# ==============================================================================

# --------------------------------------------------
# 1. Environment & Sensitive Credentials (CRITICAL)
# --------------------------------------------------
.env
.env.backup
.env.production
.env.testing
.env.*.local
.env.local
/auth.json
Homestead.json
Homestead.yaml

# --------------------------------------------------
# 2. Dependency Directories
# --------------------------------------------------
/vendor/
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --------------------------------------------------
# 3. Laravel Storage & Runtime Files
# --------------------------------------------------
/storage/*.key
/storage/pail/
/storage/logs/*.log
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
!/storage/framework/cache/data/.gitkeep
!/storage/framework/sessions/.gitkeep
!/storage/framework/testing/.gitkeep
!/storage/framework/views/.gitkeep
!/storage/logs/.gitkeep

# Storage app private & public runtime files
/storage/app/private/*
/storage/app/public/*
!/storage/app/private/.gitkeep
!/storage/app/public/.gitkeep
!/storage/app/.gitkeep

# --------------------------------------------------
# 4. Public Directory — Prevent User Upload Bloat
# --------------------------------------------------
/public/storage
/public/hot
# /public/build/ (Kept tracked so production servers without Node/npm have manifest.json and compiled bundles)

# User-uploaded assets in public directory (keep folder structure only)
/public/artwork/*
!/public/artwork/.gitkeep
/public/briefs/*
!/public/briefs/.gitkeep
/public/brand_logos/*
!/public/brand_logos/.gitkeep
/public/references/*
!/public/references/.gitkeep
/public/revision_images/*
!/public/revision_images/.gitkeep

# --------------------------------------------------
# 5. Caches & Testing Artifacts
# --------------------------------------------------
.phpunit.result.cache
.phpunit.cache/
.phpactor.json
bootstrap/cache/*.php
!bootstrap/cache/.gitkeep
*.log

# --------------------------------------------------
# 6. IDEs, OS & Editor Transient Files
# --------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.swp
*.swo
*~

/.fleet/
/.idea/
/.nova/
/.vscode/
/.zed/
/.claude/
/.cursor/
/boost.json
/.styleci.yml
